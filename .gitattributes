# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicit binary files
*.pkl binary
*.parquet binary
*.jar binary
*.png binary
*.jpg binary
*.ico binary

# Explicit LF text files
*.sha256 text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.py text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
